{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022, x64, MSVC 14.44",
      "description": "The configuration CI builds, tests and packages. The toolset is pinned so a rebuild of a published package uses the compiler that built it; with /Brepro, the same source, toolset and build path give the same bytes.",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "v143,host=x64,version=14.44", "strategy": "set" },
      "binaryDir": "${sourceDir}/build-upscaling",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    },
    {
      "name": "ci",
      "inherits": "vs2022",
      "displayName": "Quick build (pull requests)",
      "description": "What build-windows builds on every push and pull request, and the fast local loop: the shipped targets and the device-free suites, without the GPU and audio smokes a hosted runner cannot run and without link-time code generation, which re-optimised the whole player once per test executable (5 test links: 77 s with it, 6 s without). Releases and the nightly full run build vs2022.",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": { "DLSS_VIDEO_PLAYER_IPO": "OFF", "DLSS_VIDEO_PLAYER_HARDWARE_TESTS": "OFF" }
    },
    {
      "name": "asan",
      "inherits": "vs2022",
      "displayName": "AddressSanitizer",
      "description": "Every object instrumented with /fsanitize=address, for the device-free suites. Not for shipping.",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": { "DLSS_VIDEO_PLAYER_ASAN": "ON", "DLSS_VIDEO_PLAYER_HARDWARE_TESTS": "OFF" }
    },
    {
      "name": "analyze",
      "inherits": "vs2022",
      "displayName": "Code analysis",
      "description": "/analyze on the three shipped targets; a finding fails the build.",
      "binaryDir": "${sourceDir}/build-analyze",
      "cacheVariables": { "BUILD_TESTING": "OFF", "DLSS_VIDEO_PLAYER_ANALYZE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "vs2022", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "ci", "configurePreset": "ci", "configuration": "Release" },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "Release",
      "targets": [
        "RecentMediaTests", "RenderSettingsTests", "CachedExportTests", "RuntimeLockTests",
        "RangeSelectionTests", "FrameIdentityTests", "NeuralWorkerTests", "UpscalingTests",
        "UpdateCheckTests", "PolicyTests", "ReleaseApiCompileTests", "NeuralPrerenderTests",
        "PlayerUiRegressionTests", "ConvertTests"
      ]
    },
    {
      "name": "analyze",
      "configurePreset": "analyze",
      "configuration": "Release",
      "targets": [ "DLSSVideoPlayer", "NeuralWorker", "dlss5-convert" ]
    }
  ],
  "testPresets": [
    {
      "name": "portable",
      "displayName": "Device-free suites",
      "configurePreset": "vs2022",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "gpu|audio" } }
    },
    {
      "name": "quick",
      "displayName": "Quick tier (pull requests)",
      "description": "The device-free suites minus the `slow` tier (PolicyTestsSlow, CachedExportTests), which the nightly and release runs add back with the portable preset.",
      "configurePreset": "ci",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "gpu|audio|slow" } }
    },
    {
      "name": "hardware",
      "displayName": "GPU and audio suites",
      "configurePreset": "vs2022",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "gpu|audio" } }
    },
    {
      "name": "asan",
      "displayName": "Device-free suites under AddressSanitizer",
      "configurePreset": "asan",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "gpu|audio" } }
    }
  ]
}
